<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patienthandover.domain">
    <class name="PatientHandoverTask" table="patient_handover_task">
        <id name="id" column="patient_handover_task_id" type="java.lang.Integer"><generator class="native"/></id>
        <property name="uuid" column="uuid" type="java.lang.String" not-null="true" unique="true"/>
        <many-to-one name="handover" class="PatientHandover" column="patient_handover_id" not-null="true"/>
        <property name="description" column="description" type="java.lang.String" not-null="true"/>
        <property name="dueDate" column="due_date" type="java.util.Date"/>
        <many-to-one name="assignee" class="org.openmrs.Provider" column="assignee_provider_id"/>
        <property name="completed" column="completed" type="boolean" not-null="true"/>
        <many-to-one name="completedBy" class="org.openmrs.User" column="completed_by"/>
        <property name="dateCompleted" column="date_completed" type="java.util.Date"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
        <property name="dateCreated" column="date_created" type="java.util.Date" not-null="true"/>
        <many-to-one name="changedBy" class="org.openmrs.User" column="changed_by"/>
        <property name="dateChanged" column="date_changed" type="java.util.Date"/>
        <property name="voided" column="voided" type="boolean" not-null="true"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided" type="java.util.Date"/>
        <property name="voidReason" column="void_reason" type="java.lang.String"/>
    </class>
</hibernate-mapping>