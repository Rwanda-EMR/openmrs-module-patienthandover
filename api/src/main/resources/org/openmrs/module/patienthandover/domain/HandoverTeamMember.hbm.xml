<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.patienthandover.domain">
 <class name="HandoverTeamMember" table="handover_team_member">
  <id name="id" column="handover_team_member_id"><generator class="native"/></id>
  <property name="handoverType" column="handover_type" not-null="true" length="20"/>
  <property name="transactionKey" column="transaction_key" not-null="true" length="50"/>
  <many-to-one name="person" class="org.openmrs.Person" column="person_id" not-null="true"/>
  <property name="role" column="participant_role" not-null="true" length="12"/>
  <property name="signed" not-null="true"/>
  <many-to-one name="signedBy" class="org.openmrs.User" column="signed_by"/>
  <property name="dateSigned" column="date_signed"/>
  <many-to-one name="creator" class="org.openmrs.User" column="creator" not-null="true"/>
  <property name="dateCreated" column="date_created" not-null="true"/>
  <many-to-one name="changedBy" class="org.openmrs.User" column="changed_by"/>
  <property name="dateChanged" column="date_changed"/>
  <property name="voided" not-null="true"/>
  <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
  <property name="dateVoided" column="date_voided"/>
  <property name="voidReason" column="void_reason"/>
  <property name="uuid" unique="true" length="38" not-null="true"/>
 </class>
</hibernate-mapping>
