<changeSet id="patienthandover-2026-08-26-003" author="codex">
 <preConditions onFail="MARK_RAN"><not><columnExists tableName="patient_handover" columnName="cancelled"/></not></preConditions>
 <comment>Add audited soft cancellation for patient handover transactions</comment>
