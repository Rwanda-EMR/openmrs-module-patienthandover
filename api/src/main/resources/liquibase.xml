  <column name="cancelled" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
  <column name="cancelled_by" type="int"/>
  <column name="date_cancelled" type="datetime"/>
  <column name="cancellation_reason" type="varchar(1000)"/>
 </addColumn>
 <addForeignKeyConstraint constraintName="patient_handover_cancelled_by_fk" baseTableName="patient_handover" baseColumnNames="cancelled_by" referencedTableName="users" referencedColumnNames="user_id"/>
</changeSet>
