<% ui.decorateWith("appui","standardEmrPage"); ui.includeCss("patienthandover","patienthandover.css"); def rows=binding.hasVariable('laboratoryWorklist')?laboratoryWorklist:[]; def handovers=binding.hasVariable('laboratoryHandovers')?laboratoryHandovers:[]; def recentHandovers=binding.hasVariable('recentLaboratoryHandovers')?recentLaboratoryHandovers:[]; def teams=binding.hasVariable('laboratoryTeams')?laboratoryTeams:[:] %>
<script>
var breadcrumbs=[{icon:"icon-home",link:'/'+OPENMRS_CONTEXT_PATH+'/index.htm'},{label:"Laboratory Handover"}];
function labSync(i){var o=document.getElementById('labProviders').options,id='';for(var x=0;x<o.length;x++)if(o[x].value===i.value){id=o[x].dataset.id;break;}i.nextElementSibling.value=id;i.setCustomValidity(id?'':'Select a provider from the suggestions.');}
function labAdd(box,name){var d=document.createElement('div');d.className='ph-team-row';d.innerHTML='<input type="text" list="labProviders" placeholder="Type provider name" onchange="labSync(this)" required/><input type="hidden" name="'+name+'"/><button type="button" onclick="this.parentNode.remove()">Remove</button>';document.getElementById(box).appendChild(d);d.firstElementChild.focus();}
function labAll(c){document.querySelectorAll('input[name=laboratoryRowKeys]').forEach(function(x){x.checked=c.checked;});}
</script>
<div class="ph-page">
${ui.includeFragment("patienthandover","handoverNavigation",[activeTab:"laboratory"])}
<h2>Laboratory Handover</h2>
<p class="ph-location-card"><strong>Login location:</strong> ${currentLocation?.name?:'Select a location'}</p>
<%if(!laboratoryLocationAllowed){%><div class="ph-alert-error">Laboratory handovers are available only when signed in at a laboratory service location. Administrators may explicitly configure location IDs in <code>patienthandover.laboratoryLocationIds</code>.</div></div><%return%><%}%>
<%if(binding.hasVariable('laboratoryMessage')){%><div class="ph-alert-success">${laboratoryMessage}</div><%}%>
<%if(binding.hasVariable('laboratoryError')){%><div class="ph-alert-error">${laboratoryError}</div><%}%>
<%if(!laboratoryConfigured){%><div class="ph-alert-error">Laboratory worklist is unavailable. Configure the global property <code>laboratorymanagement.orderType.labOrderTypeId</code>.</div><%}%>
<datalist id="labProviders"><%providers.each{p->if(!p.retired){%><option value="${p.name}" data-id="${p.providerId}"></option><%}}%></datalist>

<%if(handovers){%><h3>Pending laboratory handovers</h3><div class="ph-table-scroll"><table class="ph-table"><thead><tr><th>Reference</th><th>Submitted</th><th>Shift</th><th>Patients</th><th>Team progress</th><th>Action</th></tr></thead><tbody>
<%handovers.eachWithIndex{h,n->def team=teams[h.uuid]?:[];def senders=team.findAll{it.role=='OUTGOING'&&!it.voided};def receivers=team.findAll{it.role=='RECEIVING'&&!it.voided};def assignment=team.find{!it.signed&&it.person?.personId==currentUser?.person?.personId};def canEdit=(h.creator?.userId==currentUser?.userId)||canManageLaboratory;%>
<tr><td>${h.transactionReference}</td><td>${h.dateSubmitted}</td><td>${h.shift}</td><td>${h.items.size()}</td><td><details class="ph-members-details"><summary>View members</summary><div class="ph-team-popover"><button type="button" class="ph-team-popover-close" onclick="this.closest('details').removeAttribute('open')">Close</button><section><h4>Sending Team</h4><%senders.each{m->%><div class="ph-member-status ${m.signed?'is-signed':'is-pending'}"><span>${m.person?.personName}</span><small>${m.signed?'Signed '+m.dateSigned:'Pending signature'}</small></div><%}%></section><section><h4>Receiving Team</h4><%receivers.each{m->%><div class="ph-member-status ${m.signed?'is-signed':'is-pending'}"><span>${m.person?.personName}</span><small>${m.signed?'Signed '+m.dateSigned:'Pending signature'}</small></div><%}%></section></div></details><div>Senders: ${senders.count{it.signed}}/${senders.size()} Receivers: ${receivers.count{it.signed}}/${receivers.size()}</div></td>
<td><div class="ph-report-actions"><button type="button" onclick="document.getElementById('lab-${n}').showModal()">View patients</button><%if(canEdit){%><button type="button" onclick="document.getElementById('lab-edit-${n}').showModal()">Edit</button><%}%><a class="ph-button-link" href="${openmrsContextPath}/module/patienthandover/handoverPdf.form?type=LABORATORY&amp;key=${h.uuid}">Download PDF</a><%if(assignment&&(assignment.role=='OUTGOING'||senders.every{it.signed})){%><form method="post" class="ph-inline-form"><input type="hidden" name="action" value="sign"/><input type="hidden" name="handoverUuid" value="${h.uuid}"/><button type="submit">${assignment.role=='OUTGOING'?'Sign as sender':'Mark my receipt'}</button></form><%}%></div>
<dialog id="lab-${n}" class="ph-edit-dialog ph-team-dialog"><div class="ph-dialog-header"><h3>${h.transactionReference}</h3><button type="button" class="ph-dialog-close" onclick="this.closest('dialog').close()">&times;</button></div><table class="ph-table"><thead><tr><th>Patient</th><th>Identifier</th><th>Lab code</th><th>Ordered</th><th>Comment</th></tr></thead><tbody><%h.items.each{i->%><tr><td>${i.patientName}</td><td>${i.patientIdentifier}</td><td>${i.labCode}</td><td>${i.orderedOn}</td><td>${i.comment?:'-'}</td></tr><%}%></tbody></table></dialog>
<%if(canEdit){%><dialog id="lab-edit-${n}" class="ph-edit-dialog ph-laboratory-edit-dialog"><form method="post"><div class="ph-dialog-header"><h3>Edit ${h.transactionReference}</h3><button type="button" class="ph-dialog-close" onclick="this.closest('dialog').close()">&times;</button></div><input type="hidden" name="action" value="editHandover"/><input type="hidden" name="handoverUuid" value="${h.uuid}"/><div class="ph-edit-lab-list"><%h.items.each{i->%><label><strong>${i.patientName}</strong><small>${i.patientIdentifier} &middot; ${i.labCode}</small><textarea name="editComment_${i.id}" maxlength="2000" rows="3">${i.comment?:''}</textarea></label><%}%></div><div class="ph-dialog-actions"><button type="button" onclick="this.closest('dialog').close()">Close</button><button type="submit">Save changes</button></div></form></dialog><%}%></td></tr><%}%>
</tbody></table></div><%}%>

<%def completedHandovers=recentHandovers.findAll{it.status!='PENDING'};if(completedHandovers){%><div class="ph-section-heading"><h3>Recent completed laboratory handovers</h3><a class="ph-button-link" href="${ui.pageLink('patienthandover','laboratoryHandoverReport')}">View full report</a></div><div class="ph-table-scroll"><table class="ph-table ph-compact-table"><thead><tr><th>Reference</th><th>Submitted</th><th>Shift</th><th>Status</th><th>Received</th><th>Patients</th><th>Action</th></tr></thead><tbody><%completedHandovers.eachWithIndex{h,n->%><tr><td>${h.transactionReference}</td><td>${h.dateSubmitted}</td><td>${h.shift}</td><td>${h.status}</td><td>${h.dateReceived?:'-'}</td><td>${h.items.size()}</td><td><div class="ph-report-actions"><details><summary>View patients</summary><div class="ph-recent-lab-items"><%h.items.each{i->%><div><strong>${i.patientName}</strong> &middot; ${i.patientIdentifier} &middot; ${i.labCode}<br/><small>${i.comment?:'No comment'}</small></div><%}%></div></details><a class="ph-button-link" href="${openmrsContextPath}/module/patienthandover/handoverPdf.form?type=LABORATORY&amp;key=${h.uuid}">Download PDF</a></div></td></tr><%}%></tbody></table></div><%}%>

<h3>Laboratory worklist period</h3><form method="get" class="ph-laboratory-period"><label>From <input type="date" name="fromDate" value="${fromDate}" required/></label><label>To <input type="date" name="toDate" value="${toDate}" required/></label><button type="submit">Load worklist</button></form>
<h3>Find and add a patient</h3><form method="get" class="ph-laboratory-search"><input type="hidden" name="fromDate" value="${fromDate}"/><input type="hidden" name="toDate" value="${toDate}"/><label>Patient, identifier or lab code <input type="text" name="search" value="${search}"/></label><button type="submit">Search patient</button></form>
<%if(binding.hasVariable('laboratorySearchResults')){%><%if(!laboratorySearchResults){%><div class="ph-alert-info">No patient with a pending coded laboratory order was found. Patients whose results are already recorded cannot be added.</div><%}else{%><div class="ph-table-scroll"><table class="ph-table"><thead><tr><th>Patient</th><th>Identifier</th><th>Lab code</th><th>Action</th></tr></thead><tbody><%laboratorySearchResults.each{r->%><tr><td>${r.patientName}</td><td>${r.identifier}</td><td>${r.labCode}</td><td><form method="post"><input type="hidden" name="action" value="addManual"/><input type="hidden" name="rowKey" value="${r.key}"/><button type="submit">Add to worklist</button></form></td></tr><%}%></tbody></table></div><%}%><%}%>

<div class="ph-section-heading"><h3>Patients with a lab code and no result</h3><a class="ph-button-link" href="${ui.pageLink('patienthandover','laboratoryHandover',[viewAll:'true',fromDate:fromDate,toDate:toDate])}">View all</a></div>
<form method="post">
<input type="hidden" name="fromDate" value="${fromDate}"/><input type="hidden" name="toDate" value="${toDate}"/>
<div class="ph-handover-team-row"><div class="ph-equipment-shift"><label>Shift</label><select name="shift" required><option value="">Select shift</option><option value="DAY">DAY</option><option value="NIGHT">NIGHT</option></select></div><fieldset><legend>Sending team</legend><p>Current logged-in user is included and signed automatically.</p><div id="labSenders"></div><button type="button" onclick="labAdd('labSenders','outgoingProviderIds')">Add sender</button></fieldset><fieldset><legend>Receiving team</legend><div id="labReceivers"></div><button type="button" onclick="labAdd('labReceivers','receivingProviderIds')">Add receiver</button></fieldset></div>
<div class="ph-table-scroll"><table class="ph-table ph-laboratory-worklist"><thead><tr><th><input type="checkbox" onchange="labAll(this)"/> Select all</th><th>Patient name</th><th>Identifier</th><th>Lab code</th><th>Ordered on</th><th>Comment</th><th>Remove</th></tr></thead><tbody>
<%rows.each{r->%><tr><td><input type="checkbox" name="laboratoryRowKeys" value="${r.key}"/></td><td>${r.patientName}</td><td>${r.identifier}</td><td>${r.labCode}</td><td>${r.orderedOn}</td><td><textarea name="comment_${r.safeKey}" rows="2" maxlength="2000" placeholder="Laboratory handover comment"></textarea></td><td><button type="submit" name="removeKey" value="${r.key}">Remove</button></td></tr><%}%>
</tbody></table></div><div class="ph-laboratory-submit"><button type="submit" name="action" value="submit">Submit selected patients</button></div></form>
</div>
