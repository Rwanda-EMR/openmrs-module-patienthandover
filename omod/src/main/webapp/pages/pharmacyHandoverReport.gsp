<%
ui.decorateWith("appui", "standardEmrPage")
ui.includeCss("patienthandover", "patienthandover.css")
def rows=binding.hasVariable('handovers')?handovers:[]
def pharmacyNames=binding.hasVariable('pharmacies')?pharmacies:[]
def historyByHandover=binding.hasVariable('pharmacyAuditEvents')?pharmacyAuditEvents:[:]
%>
<script>var breadcrumbs=[{icon:"icon-home",link:'/'+OPENMRS_CONTEXT_PATH+'/index.htm'},{label:"Saved Pharmacy Handovers"}];</script>
<div class="ph-page">${ui.includeFragment("patienthandover","handoverNavigation",[activeTab:"pharmacyReport"])}
<%if(currentLocation){%><p><strong>Login location:</strong> ${currentLocation.name}</p><%}%>
<form method="get" class="ph-filter-bar ph-report-filters">
<label>From <input type="date" name="fromDate" value="${fromDate?:''}"/></label><label>To <input type="date" name="toDate" value="${toDate?:''}"/></label>
<label>Pharmacy <select name="pharmacy"><option value="ALL">ALL</option><%pharmacyNames.each{n->%><option value="${n}" ${pharmacy==n?'selected="selected"':''}>${n}</option><%}%></select></label>
<label>Shift <select name="shift"><option ${shift=='ALL'?'selected':''}>ALL</option><option ${shift=='DAY'?'selected':''}>DAY</option><option ${shift=='NIGHT'?'selected':''}>NIGHT</option></select></label>
<label>Status <select name="status"><option ${status=='ALL'?'selected':''}>ALL</option><option ${status=='PENDING'?'selected':''}>PENDING</option><option ${status=='RECEIVED'?'selected':''}>RECEIVED</option></select></label>
<button type="submit">Run report</button><%if(canExportReports){%><button type="submit" formaction="${openmrsContextPath}/module/patienthandover/handoverPdf.form" name="type" value="PHARMACY">Download PDF</button><%}%><%if(canExportReports){%><button type="submit" name="export" value="true" formaction="${openmrsContextPath}/module/patienthandover/pharmacyHandoverReport.form">Download CSV</button><%}%></form>
<div class="ph-report-summary"><div class="ph-report-summary-card"><strong>${rows.size()}</strong><span>Filtered pharmacy handovers</span></div><div class="ph-report-summary-card"><strong>${rows.count{it.status=='PENDING'}}</strong><span>Pending</span></div><div class="ph-report-summary-card"><strong>${rows.count{it.status=='RECEIVED'}}</strong><span>Received</span></div></div><p class="ph-report-note">Items show the handed snapshot. View history shows later amendments and each member's individual signature time.</p><div class="ph-report-toolbar"><a class="ph-button-link" href="${openmrsContextPath}/patienthandover/pharmacyHandover.page#pending-pharmacy-handovers">Manage handovers</a><span>Edit, cancel, reassign teams, or complete pending pharmacy handovers.</span></div>
<div class="ph-table-scroll"><table class="ph-table"><thead><tr><th>Submitted</th><th>Pharmacy</th><th>Shift</th><th>Team progress</th><th>Status</th><th>Received time</th><th>Stock lines</th><th>Action</th></tr></thead><tbody>
<%if(!rows){%><tr><td colspan="8">No pharmacy handovers match these filters.</td></tr><%}else{rows.eachWithIndex{h,index-> def hasTeam=h.participants && !h.participants.empty; def senders=hasTeam?h.participants.findAll{it.role=='OUTGOING'}:[]; def receivers=hasTeam?h.participants.findAll{it.role=='RECEIVING'}:[]; def senderSigned=hasTeam?senders.count{it.signed}:1; def senderTotal=hasTeam?senders.size():1; def receiverSigned=hasTeam?receivers.count{it.signed}:(h.status=='RECEIVED'?1:0); def receiverTotal=hasTeam?receivers.size():1; def auditRows=historyByHandover[h.uuid]?:[];%>
<tr class="ph-report-batch-row"><td>${h.dateSubmitted}</td><td>${h.pharmacyName}</td><td>${h.shift}</td><td><details class="ph-members-details"><summary>View members</summary><div class="ph-team-popover"><button type="button" class="ph-team-popover-close" onclick="this.closest('details').removeAttribute('open')">Close</button><section><h4>Sending Team <span>${senderSigned}/${senderTotal}</span></h4><%if(hasTeam){senders.each{member->%><div class="ph-member-status ${member.signed?'is-signed':'is-pending'}"><span>${member.person?.personName?.fullName?:'-'}</span><small>${member.signed?'Signed '+(member.dateSigned?:''):'Remaining'}</small></div><%}}else{%><div class="ph-member-status is-signed"><span>${h.creator?.person?.personName?.fullName?:'-'}</span><small>Signed ${h.dateSubmitted?:''}</small></div><%}%></section><section><h4>Receiving Team <span>${receiverSigned}/${receiverTotal}</span></h4><%if(hasTeam){receivers.each{member->%><div class="ph-member-status ${member.signed?'is-signed':'is-pending'}"><span>${member.person?.personName?.fullName?:'-'}</span><small>${member.signed?'Signed '+(member.dateSigned?:''):'Remaining'}</small></div><%}}else{%><div class="ph-member-status ${h.status=='RECEIVED'?'is-signed':'is-pending'}"><span>${h.receivingProvider?.name?:'-'}</span><small>${h.status=='RECEIVED'?'Signed '+(h.dateAcknowledged?:''):'Remaining'}</small></div><%}%></section></div></details></td><td>${h.status}</td><td>${h.dateAcknowledged?:'-'}</td><td>${h.items.size()}</td><td><div class="ph-report-actions"><button type="button" onclick="togglePharmacyDetail('pharmacy-items-${index}')">View items</button><button type="button" onclick="togglePharmacyDetail('pharmacy-history-${index}')">View history</button><%if(canExportReports){%><a class="ph-button-link" href="${openmrsContextPath}/module/patienthandover/pharmacyHandoverReport.form?handoverUuid=${h.uuid}">Export CSV</a><%}%><%if(canExportReports){%><a class="ph-button-link" href="${openmrsContextPath}/module/patienthandover/handoverPdf.form?type=PHARMACY&amp;key=${h.uuid}">Download PDF</a><%}%></div></td></tr>
<tr id="pharmacy-items-${index}" class="ph-handover-detail-row" style="display:none"><td colspan="8"><div class="ph-handover-detail"><h4>Handed stock-item snapshot</h4><table class="ph-table ph-compact-table"><thead><tr><th>Item</th><th>Code</th><th>Batch</th><th>Expiry date</th><th>Handed quantity</th></tr></thead><tbody><%h.items.each{i->%><tr><td>${i.itemName}</td><td>${i.itemCode?:'-'}</td><td>${i.batchNumber?:'-'}</td><td>${i.expiryDate?new java.text.SimpleDateFormat("yyyy-MM-dd").format(i.expiryDate):'-'}</td><td>${i.availableQuantity}</td></tr><%}%></tbody></table></div></td></tr>
<tr id="pharmacy-history-${index}" class="ph-handover-detail-row" style="display:none"><td colspan="8"><div class="ph-handover-detail"><h4>Handover history</h4><table class="ph-table ph-compact-table"><thead><tr><th>Time</th><th>Event</th><th>User</th><th>Details</th></tr></thead><tbody><%if(auditRows){auditRows.each{event->%><tr><td>${event.eventDate}</td><td>${event.eventType}</td><td>${event.user?.person?.personName?:event.user?.username?:'-'}</td><td>${event.details?:'-'}</td></tr><%}}else{%><tr><td colspan="4">No recorded history is available for this handover.</td></tr><%}%></tbody></table></div></td></tr>
<%}}%></tbody></table></div>
${ui.includeFragment("patienthandover","pagination",[pageName:"pharmacyHandoverReport",currentPage:binding.hasVariable('pharmacyReportCurrentPage')?pharmacyReportCurrentPage:1,totalPages:binding.hasVariable('pharmacyReportTotalPages')?pharmacyReportTotalPages:1,totalItems:binding.hasVariable('pharmacyReportTotalItems')?pharmacyReportTotalItems:0,itemLabel:"handover",parameters:[fromDate:fromDate,toDate:toDate,pharmacy:pharmacy,shift:shift,status:status]])}
</div><script>function togglePharmacyDetail(id){var row=document.getElementById(id);row.style.display=row.style.display==='table-row'?'none':'table-row';}</script>
