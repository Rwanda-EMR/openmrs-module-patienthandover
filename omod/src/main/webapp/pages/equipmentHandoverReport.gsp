<%ui.decorateWith("appui","standardEmrPage");ui.includeCss("patienthandover","patienthandover.css");def rows=binding.hasVariable('handovers')?handovers:[];def teams=binding.hasVariable('equipmentTeams')?equipmentTeams:[:]%>
<script>var breadcrumbs=[{icon:"icon-home",link:'/'+OPENMRS_CONTEXT_PATH+'/index.htm'},{label:"Equipment Handover Report"}];function eqDetail(id){var r=document.getElementById(id);r.style.display=r.style.display==='table-row'?'none':'table-row';}</script>
<div class="ph-page">${ui.includeFragment("patienthandover","handoverNavigation",[activeTab:"equipmentReport"])}<h2>Equipment Handover Report</h2><%if(currentLocation){%><p class="ph-location-card"><strong>Login location:</strong> ${currentLocation.name}</p><%}%>
<form method="get" class="ph-filter-bar ph-report-filters"><label>From <input type="date" name="fromDate" value="${fromDate?:''}"/></label><label>To <input type="date" name="toDate" value="${toDate?:''}"/></label><label>Shift<select name="shift"><option ${shift=='ALL'?'selected':''}>ALL</option><option ${shift=='DAY'?'selected':''}>DAY</option><option ${shift=='NIGHT'?'selected':''}>NIGHT</option></select></label><label>Status<select name="status"><option ${status=='ALL'?'selected':''}>ALL</option><option ${status=='PENDING'?'selected':''}>PENDING</option><option ${status=='RECEIVED'?'selected':''}>RECEIVED</option></select></label><button type="submit">Run report</button><%if(canExportReports){%><a class="ph-button-link ph-print-button" href="${openmrsContextPath}/module/patienthandover/handoverPdf.form?type=EQUIPMENT&amp;report=true&amp;fromDate=${java.net.URLEncoder.encode(fromDate?:'', 'UTF-8')}&amp;toDate=${java.net.URLEncoder.encode(toDate?:'', 'UTF-8')}&amp;shift=${java.net.URLEncoder.encode(shift?:'ALL', 'UTF-8')}&amp;status=${java.net.URLEncoder.encode(status?:'ALL', 'UTF-8')}">Download PDF</a><button type="submit" name="export" value="true">Download CSV</button><%}%></form>
<div class="ph-report-summary"><div class="ph-report-summary-card"><strong>${equipmentReportCount}</strong><span>Filtered equipment handovers</span></div><div class="ph-report-summary-card"><strong>${rows.count{it.status=='PENDING'}}</strong><span>Pending on this page</span></div><div class="ph-report-summary-card"><strong>${rows.count{it.status=='RECEIVED'}}</strong><span>Received on this page</span></div></div>
<div class="ph-table-scroll"><table class="ph-table"><thead><tr><th>Reference</th><th>Submitted</th><th>Shift</th><th>Team progress</th><th>Status</th><th>Received</th><th>Items</th><th>Action</th></tr></thead><tbody><%if(!rows){%><tr><td colspan="8">No equipment handovers match these filters.</td></tr><%}else{rows.eachWithIndex{h,n->def team=teams[h.uuid]?:[];def senders=team.findAll{it.role=='OUTGOING'&&!it.voided};def receivers=team.findAll{it.role=='RECEIVING'&&!it.voided};%><tr><td>${h.transactionReference}</td><td>${h.dateSubmitted}</td><td>${h.shift}</td><td><details class="ph-members-details"><summary>View members</summary><div class="ph-team-popover"><button type="button" class="ph-team-popover-close" onclick="this.closest('details').removeAttribute('open')">Close</button><section><h4>Sending Team</h4><%senders.each{m->%><div class="ph-member-status ${m.signed?'is-signed':'is-pending'}"><span>${m.person?.personName}</span><small>${m.signed?'Signed '+m.dateSigned:'Remaining'}</small></div><%}%></section><section><h4>Receiving Team</h4><%receivers.each{m->%><div class="ph-member-status ${m.signed?'is-signed':'is-pending'}"><span>${m.person?.personName}</span><small>${m.signed?'Signed '+m.dateSigned:'Remaining'}</small></div><%}%></section></div></details><small>Senders ${senders.count{it.signed}}/${senders.size()} &nbsp; Receivers ${receivers.count{it.signed}}/${receivers.size()}</small></td><td>${h.status}</td><td>${h.dateReceived?:'-'}</td><td>${h.items.size()}</td><td><div class="ph-report-actions"><button type="button" onclick="eqDetail('eq-report-${n}')">View items</button><%if(canExportReports){%><a class="ph-button-link" href="${openmrsContextPath}/module/patienthandover/handoverPdf.form?type=EQUIPMENT&amp;key=${h.uuid}">Download PDF</a><%}%></div></td></tr><tr id="eq-report-${n}" style="display:none"><td colspan="8"><table class="ph-table ph-compact-table"><thead><tr><th>Equipment name</th><th>Quantity</th><th>Status</th><th>Observation</th></tr></thead><tbody><%h.items.each{i->%><tr><td>${i.equipmentName}</td><td>${i.quantity}</td><td>${i.equipmentStatus}</td><td>${i.observation?:'-'}</td></tr><%}%></tbody></table></td></tr><%}}%></tbody></table></div>
${ui.includeFragment("patienthandover","pagination",[pageName:"equipmentHandoverReport",currentPage:binding.hasVariable('equipmentReportCurrentPage')?equipmentReportCurrentPage:1,totalPages:binding.hasVariable('equipmentReportTotalPages')?equipmentReportTotalPages:1,totalItems:binding.hasVariable('equipmentReportTotalItems')?equipmentReportTotalItems:0,itemLabel:"handover",parameters:[fromDate:fromDate,toDate:toDate,shift:shift,status:status]])}</div>